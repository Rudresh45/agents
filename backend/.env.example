# --- app ---
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_DIR=./logs
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# --- database / storage ---
DATABASE_URL=sqlite:///./hr_agent.db
CHECKPOINT_DB=./checkpoints.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- auth ---
JWT_SECRET=dev-secret-change-me-before-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
HR_ADMIN_EMAIL=hr@example.com
HR_ADMIN_PASSWORD=change-me-hr
HR_MANAGER_EMAIL=manager@example.com
HR_MANAGER_PASSWORD=change-me-manager
CEO_EMAIL=ceo@example.com
CEO_PASSWORD=change-me-ceo

# --- internal service auth (Kestra -> backend) ---
# Generate a long random value. Do not reuse the JWT secret.
INTERNAL_SERVICE_TOKEN=

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIER=free
LLM_TIMEOUT_SECONDS=60
LLM_MIN_INTERVAL_SECONDS=4
LLM_MAX_RETRIES=3
PROMPT_VERSION=v1

# --- kestra orchestration ---
KESTRA_URL=http://localhost:8080
# Kestra OSS 1.3 requires HTTP Basic auth. Under Docker Compose these are
# supplied from the root .env as KESTRA_BASIC_AUTH_USERNAME/PASSWORD.
KESTRA_API_USERNAME=
KESTRA_API_PASSWORD=
# Enterprise API-token deployments only. Basic auth wins when both are set.
KESTRA_API_TOKEN=
KESTRA_NAMESPACE=hr.recruitment
KESTRA_FLOW_ID=hr_screening_and_decisions
KESTRA_TIMEOUT_SECONDS=30
KESTRA_MAX_RETRIES=2
KESTRA_RETRY_BASE_SECONDS=0.5
# Kestra orchestration is enabled; LangGraph retired.
USE_KESTRA_LLM=true

# --- email ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT_SECONDS=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=30
EMAIL_DRY_RUN=true

# --- mcp email server ---
MCP_EMAIL_URL=https://mcpemails.com/api/mcp
MCP_EMAIL_TOKEN=
MCP_INBOX_EMAIL=

# --- routing / policy ---
HR_MANAGER_NOTIFY_EMAIL=manager@example.com
CEO_REPORT_EMAIL=ceo@example.com
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
DEFAULT_MIN_SCORE=60
RESUME_MIN_CHARS=200
RETENTION_DAYS=180
SCHEDULER_ENABLED=false
POLL_INTERVAL_MINUTES=15
