# Docker Compose infrastructure secrets. Copy this file to `.env` and fill it in.
# Never commit the real `.env`.
#
# Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# for INTERNAL_SERVICE_TOKEN, and:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# for KESTRA_ENCRYPTION_SECRET_KEY.

POSTGRES_PASSWORD=ChangeMePostgres1

# Kestra OSS requires a valid email and a strong password.
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
KESTRA_BASIC_AUTH_PASSWORD=ChangeMeKestra1

KESTRA_ENCRYPTION_SECRET_KEY=

# Shared by the backend and Kestra. The backend rejects internal calls when
# this is empty. `kestra/make-secrets.ps1` encodes it for Kestra.
INTERNAL_SERVICE_TOKEN=

# Kestra orchestration is enabled; LangGraph retired.
USE_KESTRA_LLM=true

# Optional: the secret generator reads GEMINI_API_KEY from this file first,
# then falls back to backend/.env. Leave unset here if it is already in
# backend/.env.
# GEMINI_API_KEY=
